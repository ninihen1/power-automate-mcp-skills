# Credentials and per-user state
.mcpregistry_*_token
*.code-workspace

# GitHub Copilot CLI workspace config — may contain x-api-key headers per server.
# Project-level Copilot CLI config can land at <repo>/.copilot/* if a user runs
# the CLI from the repo root; user-level lives in ~/.copilot/ (not git-tracked).
.copilot/

# M365 Cowork plugin build output (Convert-ClaudePluginToMOS3.ps1 staging + zips)
dist/

# Cowork API plugin proxy (in-development; promote to tracked when stable)
cowork-proxy/

# ChatGPT app submission staging — skill copies generated for the OpenAI
# directory submission. The canonical skills live in skills/; these are
# derived. Ignore rather than track a second copy that will drift.
chatgpt-skills/

# Cowork plugin staging — derived skill copies for the M365 Cowork conversion.
# Canonical skills live in skills/; sibling of the ignored cowork-proxy/.
cowork-skills/

# Submission build output
flowstudio-chatgpt-skills.zip

# Windows crash dumps from Git Bash
*.stackdump
